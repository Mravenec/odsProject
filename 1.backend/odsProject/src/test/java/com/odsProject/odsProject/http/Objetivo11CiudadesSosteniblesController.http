GET {{baseUrl}}/api/ods/11/indicadores/11.c.1?proyectoId={{proyectoId}}

# ── 2. Endpoints Estandarizados (IOdsBaseController) ──

### Obtener todos los indicadores de un proyecto
GET {{baseUrl}}/api/ods/11/indicadores?proyectoId={{proyectoId}}

### Obtener un indicador específico por su ID interno
GET {{baseUrl}}/api/ods/11/indicadores/{{indicadorId}}

### Crear nuevo indicador
POST {{baseUrl}}/api/ods/11/indicadores
Content-Type: application/json

{
  "proyectoId": {{proyectoId}},
  "indicadorMasterId": 125,
  "formulaCustom": null,
  "metaValor": 100.0,
  "metaUnidad": "Porcentaje"
}

### Actualizar indicador
PUT {{baseUrl}}/api/ods/11/indicadores/{{indicadorId}}
Content-Type: application/json

{
  "id": {{indicadorId}},
  "proyectoId": {{proyectoId}},
  "indicadorMasterId": 125,
  "valorActual": 90.0,
  "metaValor": 100.0,
  "metaUnidad": "Porcentaje"
}

### Eliminar indicador
DELETE {{baseUrl}}/api/ods/11/indicadores/{{indicadorId}}

# ── 3. Gestión de Proyectos ──

### Obtener todos los proyectos del ODS11
GET {{baseUrl}}/api/ods/11/proyectos

### Obtener proyecto por ID
GET {{baseUrl}}/api/ods/11/proyectos/{{proyectoId}}

### Crear nuevo proyecto
POST {{baseUrl}}/api/ods/11/proyectos
Content-Type: application/json

{
  "usuarioId": 2,
  "sedeId": 2,
  "nombreProyecto": "Movilidad Eléctrica Urbana",
  "objetivoId": 11,
  "descripcion": "Despliegue de estaciones de carga y buses eléctricos",
  "fechaInicio": "2024-01-01",
  "fechaFin": "2024-12-31",
  "estado": "activo"
}

### Actualizar proyecto
PUT {{baseUrl}}/api/ods/11/proyectos/{{proyectoId}}
Content-Type: application/json

{
  "id": {{proyectoId}},
  "nombreProyecto": "Movilidad Eléctrica Urbana Actualizado",
  "estado": "activo"
}

### Eliminar proyecto
DELETE {{baseUrl}}/api/ods/11/proyectos/{{proyectoId}}

# ── 4. Gestión de Metas (Parámetros) ──

### Obtener metas de un proyecto
GET {{baseUrl}}/api/ods/11/metas?proyectoId={{proyectoId}}

### Obtener meta específica
GET {{baseUrl}}/api/ods/11/metas/{{metaId}}

### Crear nueva meta
POST {{baseUrl}}/api/ods/11/metas
Content-Type: application/json

{
  "proyectoIndicadorId": {{indicadorId}},
  "nombreParametro": "param_test",
  "tipoDato": "Decimal"
}

# ── 5. Mediciones Históricas ──

### Obtener mediciones de un indicador
GET {{baseUrl}}/api/ods/11/mediciones?indicadorId={{indicadorId}}

### Obtener medición específica
GET {{baseUrl}}/api/ods/11/mediciones/{{medicionId}}

### Registrar medición
POST {{baseUrl}}/api/ods/11/mediciones
Content-Type: application/json

{
  "proyectoIndicadorId": {{indicadorId}},
  "valorCalculado": 65.5,
  "fechaMedicion": "2024-09-20",
  "responsable": "Admin Ciudades"
}

# ── 6. Utilidades y Estadísticas ──

### Obtener estadísticas del ODS
GET {{baseUrl}}/api/ods/11/estadisticas

### Calcular progreso del proyecto
GET {{baseUrl}}/api/ods/11/progreso/{{proyectoId}}

### Verificar si proyecto existe
GET {{baseUrl}}/api/ods/11/proyecto/{{proyectoId}}/existe

### Verificar si indicador existe
GET {{baseUrl}}/api/ods/11/indicador/{{indicadorId}}/existe

### Validar datos de proyecto
POST {{baseUrl}}/api/ods/11/validar/proyecto
Content-Type: application/json

{
  "nombreProyecto": "Proyecto Test Ciudades",
  "usuarioId": 2
}
