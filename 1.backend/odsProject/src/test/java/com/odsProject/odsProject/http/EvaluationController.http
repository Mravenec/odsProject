### Validar ÷100 / sqrt / ^ OK
# @name validarOpsExtendidas
POST {{baseUrl}}/api/evaluacion/validar-formula
Content-Type: application/json

{
  "formula": "(p1 / 100) + sqrt(p2) + p3^2",
  "variablesDeclaradas": ["p1", "p2", "p3"]
}

> {%
  client.test("validar ops extendidas", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.valida === true, "valida");
    client.assert(response.body.sintaxisValida === true, "sintaxis");
  });
%}

### Validar paréntesis desbalanceado
# @name validarParenInvalido
POST {{baseUrl}}/api/evaluacion/validar-formula
Content-Type: application/json

{
  "formula": "p1/p2)*100",
  "variablesDeclaradas": ["p1", "p2"]
}

> {%
  client.test("validar p1/p2)*100 inválida", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.sintaxisValida === false, "sintaxis false");
    client.assert(response.body.valida === false, "no valida");
  });
%}
