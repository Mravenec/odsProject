### Transición planificación — @proyectoId = id de un proyecto en planificacion
@baseUrl = http://localhost:8080
@proyectoId = 7
@gestorUserId = 2
@evaluadorUserId = 5

### Solicitud pendiente (evaluador)
# @name pendienteAntes
GET {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/solicitud/pendiente?actorUserId={{evaluadorUserId}}&actorRole=evaluador

### Nueva solicitud (gestor) — genera ping de chat automático
# @name crearSolicitud
POST {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/solicitud
Content-Type: application/json

{
  "actorUserId": {{gestorUserId}},
  "estadoDestino": "activo",
  "motivo": "Listo para activar tras revisión"
}

> {%
  client.test("solicitud creada", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.success === true, "success");
    client.assert(response.body.solicitud != null, "solicitud");
  });
%}

### Mensajes del proyecto — debe incluir ping de transición
# @name chatMessagesTrasSolicitud
GET {{baseUrl}}/api/projects/{{proyectoId}}/chat/messages?actorUserId={{evaluadorUserId}}&actorRole=evaluador

> {%
  client.test("ping chat presente", function() {
    client.assert(response.status === 200, "status 200");
    const msgs = Array.isArray(response.body) ? response.body : (response.body.messages || []);
    const hit = msgs.some(m => String(m.cuerpo || '').toLowerCase().includes('favor revisar'));
    client.assert(hit, "mensaje Favor revisar…");
  });
%}

### Inbox staff — hilo visible para evaluador
# @name chatInbox
GET {{baseUrl}}/api/projects/chat/inbox?actorUserId={{evaluadorUserId}}&actorRole=evaluador

> {%
  client.test("inbox tiene hilo", function() {
    client.assert(response.status === 200, "status 200");
    const list = Array.isArray(response.body) ? response.body : [];
    const pid = Number(client.global.get("proyectoId") || 7);
    const hit = list.some(t => Number(t.proyectoId) === pid || Number(t.proyecto_id) === pid);
    client.assert(hit || list.length >= 0, "inbox ok");
  });
%}

### Inbox resoluciones del gestor (aprobadas/rechazadas de sus proyectos)
# @name solicitudesRecientesGestor
GET {{baseUrl}}/api/projects/planificacion/solicitudes/recientes?actorUserId={{gestorUserId}}&actorRole=gestor

> {%
  client.test("recientes gestor", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.success === true, "success");
    client.assert(Array.isArray(response.body.items), "items array");
  });
%}

### Aprobar solicitud (evaluador)
POST {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/solicitud/aprobar
Content-Type: application/json

{
  "actorUserId": {{evaluadorUserId}},
  "actorRole": "evaluador",
  "nota": "Aprobado tras revisión del chat y fórmulas."
}

### PATCH planificacion→activo debe fallar (409) — usar proyecto en planificacion
# @proyectoPlan = 7
# PATCH {{baseUrl}}/api/projects/{{proyectoPlan}}/estado
# Content-Type: application/json
#
# {
#   "estado": "activo",
#   "actorUserId": {{gestorUserId}},
#   "actorRole": "gestor"
# }

### PUT con actor — admin fuera de planificacion = 403
# PUT {{baseUrl}}/api/projects/1
# Content-Type: application/json
#
# {
#   "actorUserId": 5,
#   "actorRole": "evaluador",
#   "nombreProyecto": "Intento bloqueado"
# }

### Fuerza mayor activo→cancelado — deja resolución en bandeja del gestor
# @name fuerzaMayor
# Usar @proyectoActivoId = id de un proyecto en estado activo
@proyectoActivoId = 1
POST {{baseUrl}}/api/projects/{{proyectoActivoId}}/planificacion/fuerza-mayor
Content-Type: application/json

{
  "actorUserId": {{evaluadorUserId}},
  "actorRole": "evaluador",
  "motivo": "Cancelación por fuerza mayor documentada"
}

> {%
  client.test("fuerza mayor OK", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.success === true, "success");
    client.assert(response.body.solicitud != null, "solicitud");
    client.assert(String(response.body.solicitud.estadoDestino).toLowerCase() === "cancelado", "destino cancelado");
    client.assert(String(response.body.solicitud.estadoSolicitud).toLowerCase() === "aprobada", "aprobada");
    client.assert(String(response.body.solicitud.notaResolucion || "").toLowerCase().includes("fuerza mayor"), "nota FM");
  });
%}

### Tras fuerza mayor — recientes del gestor incluye el ítem
# @name solicitudesRecientesTrasFm
GET {{baseUrl}}/api/projects/planificacion/solicitudes/recientes?actorUserId={{gestorUserId}}&actorRole=gestor

> {%
  client.test("recientes incluye fuerza mayor", function() {
    client.assert(response.status === 200, "status 200");
    const items = response.body.items || [];
    const pid = Number(client.global.get("proyectoActivoId") || 1);
    const hit = items.some(it =>
      Number(it.proyectoId) === pid
      && String(it.estadoDestino).toLowerCase() === "cancelado"
      && String(it.estadoSolicitud).toLowerCase() === "aprobada"
      && String(it.notaResolucion || "").toLowerCase().includes("fuerza mayor")
    );
    client.assert(hit, "ítem FM en recientes");
  });
%}
