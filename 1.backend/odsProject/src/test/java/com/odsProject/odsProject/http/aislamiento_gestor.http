### Aislamiento gestor — un solo gestor UTN (jartavia id=2)
@baseUrl = http://localhost:8080

### @name loginGestor
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "jartavia@utn.ac.cr",
  "password": "password123"
}

> {%
  client.global.set("tokenGestor", response.body.token);
  client.test("login gestor", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(!!response.body.token, "token");
  });
%}

### @name loginEvaluador
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "khernandez@utn.ac.cr",
  "password": "password123"
}

> {%
  client.global.set("tokenEval", response.body.token);
%}

### Gestor — with-ods solo suyos
GET {{baseUrl}}/api/projects/with-ods
Authorization: Bearer {{tokenGestor}}

> {%
  client.test("gestor solo propios", function() {
    client.assert(response.status === 200, "200");
    const list = response.body || [];
    client.assert(list.length >= 1, "tiene proyectos");
    const ids = list.map(p => p.proyectoId || p.proyecto_id || p.id);
    client.assert(ids.includes(7) || ids.includes(1), "incluye mock propio");
  });
%}

### Gestor — IDOR user/3 (evaluador) → 403
GET {{baseUrl}}/api/projects/user/3/with-ods
Authorization: Bearer {{tokenGestor}}

> {%
  client.test("IDOR 403", function() {
    client.assert(response.status === 403, "403");
  });
%}

### Evaluador — ve todos
GET {{baseUrl}}/api/projects/with-ods
Authorization: Bearer {{tokenEval}}

> {%
  client.test("staff ve todos", function() {
    client.assert(response.status === 200, "200");
    client.assert((response.body || []).length >= 2, "varios proyectos");
  });
%}
