### GATE_HTTP — Bitácora admin + LOGOUT fiable (logout_audit)
@baseUrl = http://localhost:8080

### @name loginAdmin
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "admin@utn.ac.cr",
  "password": "Admin1234!"
}

> {%
  client.global.set("tokenAdmin", response.body.token);
  client.test("login admin", function() {
    client.assert(response.status === 200, "200");
    client.assert(!!response.body.token, "token");
  });
%}

### @name logoutAdmin
POST {{baseUrl}}/api/login/auth/logout
Authorization: Bearer {{tokenAdmin}}

> {%
  client.test("logout admin", function() {
    client.assert(response.status === 200, "200");
    client.assert(response.body === true || response.body === "true", "true");
  });
%}

### @name loginAdminAfterLogout
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "admin@utn.ac.cr",
  "password": "Admin1234!"
}

> {%
  client.global.set("tokenAdmin", response.body.token);
%}

### @name loginGestor
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "jartavia@utn.ac.cr",
  "password": "password123"
}

> {%
  client.global.set("tokenGestor", response.body.token);
%}

### Sin token → 401
GET {{baseUrl}}/api/login/admin/audit-recent?dias=7

> {%
  client.test("sin token 401", function() {
    client.assert(response.status === 401, "401");
  });
%}

### Gestor → 403
GET {{baseUrl}}/api/login/admin/audit-recent?dias=7
Authorization: Bearer {{tokenGestor}}

> {%
  client.test("gestor 403", function() {
    client.assert(response.status === 403, "403");
  });
%}

### Admin → 200
GET {{baseUrl}}/api/login/admin/audit-recent?dias=7
Authorization: Bearer {{tokenAdmin}}

> {%
  client.test("admin 200", function() {
    client.assert(response.status === 200, "200");
    client.assert(Array.isArray(response.body), "array");
  });
%}

### Failed attempts sin token → 401
GET {{baseUrl}}/api/login/auth/failed-attempts?horas=24

> {%
  client.test("failed 401", function() {
    client.assert(response.status === 401, "401");
  });
%}

### Active users gestor → 403
GET {{baseUrl}}/api/login/admin/active-users
Authorization: Bearer {{tokenGestor}}

> {%
  client.test("active-users gestor 403", function() {
    client.assert(response.status === 403, "403");
  });
%}
