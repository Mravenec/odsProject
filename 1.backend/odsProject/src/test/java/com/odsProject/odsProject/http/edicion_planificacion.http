### Edición planificación — proyecto en planificacion
### GATE_HTTP ODS-223 — rename parámetro nombreVariable Z→G (persistencia)
@baseUrl = http://localhost:8080
@proyectoId = 7
@gestorUserId = 2
@evaluadorUserId = 5
@adminUserId = 1

### GET editable (evaluador)
# @name getEditableEval
GET {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/editable?actorUserId={{evaluadorUserId}}&actorRole=evaluador

> {%
  client.test("GET editable 200", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.success === true, "success");
    client.assert(Array.isArray(response.body.indicadores), "indicadores array");
  });
  const inds = response.body.indicadores || [];
  const withParams = inds.find(i => Array.isArray(i.parametros) && i.parametros.length > 0);
  if (withParams) {
    client.global.set("piId", String(withParams.proyectoIndicadorId));
    client.global.set("odsId", String(withParams.odsId));
    client.global.set("masterId", String(withParams.indicadorMasterId));
    client.global.set("metaValor", String(withParams.metaValor != null ? withParams.metaValor : 80));
    client.global.set("metaUnidad", withParams.metaUnidad || "Porcentaje");
    client.global.set("metaNombre", withParams.metaNombre || "Meta QA");
    const params = withParams.parametros;
    // Prefer param named Z (demo); else last param
    const target = params.find(p => (p.nombreVariable || p.nombreParametro) === "Z") || params[params.length - 1];
    client.global.set("paramId", String(target.id));
    client.global.set("oldVar", target.nombreVariable || target.nombreParametro || "Z");
    // Keep sibling params unchanged
    client.global.set("paramsJson", JSON.stringify(params.map(p => {
      const isTarget = String(p.id) === String(target.id);
      const varName = isTarget ? "G" : (p.nombreVariable || p.nombreParametro);
      return {
        id: p.id,
        nombreParametro: varName,
        nombreVariable: varName,
        tipoDato: p.tipoDato || "Decimal"
      };
    })));
    let formula = withParams.formulaCustom || "G";
    const oldVar = target.nombreVariable || target.nombreParametro || "Z";
    if (oldVar && oldVar !== "G") {
      formula = formula.replace(new RegExp("\\b" + oldVar.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\b", "g"), "G");
    }
    client.global.set("formulaG", formula);
  }
%}

### GET editable (gestor dueño)
GET {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/editable?actorUserId={{gestorUserId}}&actorRole=gestor

### PUT /full — rename param → nombreVariable G + formula (ODS-223)
# Requiere variables de getEditableEval (piId, paramsJson, formulaG)
# @name putRenameParamG
PUT {{baseUrl}}/api/projects/{{proyectoId}}/full
Content-Type: application/json

{
  "actorUserId": {{evaluadorUserId}},
  "actorRole": "evaluador",
  "proyecto": {
    "nombreProyecto": "Proyecto QA planificación (editado)"
  },
  "odsIds": [{{odsId}}],
  "primaryOdsId": {{odsId}},
  "indicadores": [
    {
      "proyectoIndicadorId": {{piId}},
      "odsId": {{odsId}},
      "indicadorMasterId": {{masterId}},
      "metaValor": {{metaValor}},
      "metaUnidad": "{{metaUnidad}}",
      "metaNombre": "{{metaNombre}}",
      "formulaCustom": "{{formulaG}}",
      "parametros": {{paramsJson}}
    }
  ]
}

> {%
  client.test("PUT rename param 200", function() {
    client.assert(response.status === 200, "status 200 got " + response.status);
    client.assert(response.body.success === true, "success; errores=" + JSON.stringify(response.body.errores || []));
  });
%}

### GET editable — assert nombreVariable G persistió (ODS-223)
# @name getEditableAfterRename
GET {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/editable?actorUserId={{evaluadorUserId}}&actorRole=evaluador

> {%
  client.test("nombreVariable G persistió tras refresh", function() {
    client.assert(response.status === 200, "status 200");
    const piId = Number(client.global.get("piId"));
    const paramId = Number(client.global.get("paramId"));
    const inds = response.body.indicadores || [];
    const ind = inds.find(i => Number(i.proyectoIndicadorId) === piId);
    client.assert(!!ind, "indicador encontrado piId=" + piId);
    const param = (ind.parametros || []).find(p => Number(p.id) === paramId);
    client.assert(!!param, "param encontrado id=" + paramId);
    client.assert(param.nombreVariable === "G", "nombreVariable=G got " + param.nombreVariable);
    client.assert(param.nombreParametro === "G", "nombreParametro=G got " + param.nombreParametro);
    const formula = ind.formulaCustom || "";
    client.assert(/\bG\b/.test(formula), "formula_custom contiene G: " + formula);
  });
%}

