### ─── GATE_HTTP ODS-238 — meta_unidad texto libre (nm / NTU / colones) ───

### GET editable — seed vars para unidad custom
# @name getEditableMetaUnidad
GET {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/editable?actorUserId={{evaluadorUserId}}&actorRole=evaluador

> {%
  client.test("GET editable 200 (meta_unidad)", function() {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.success === true, "success");
  });
  const inds = response.body.indicadores || [];
  client.assert(inds.length > 0, "hay al menos un indicador");
  const ind = inds[0];
  client.global.set("muPiId", String(ind.proyectoIndicadorId));
  client.global.set("muOdsId", String(ind.odsId));
  client.global.set("muMasterId", String(ind.indicadorMasterId));
  client.global.set("muMetaValor", String(ind.metaValor != null ? ind.metaValor : 80));
  client.global.set("muMetaNombre", ind.metaNombre || "Meta QA unidad");
  client.global.set("muFormula", ind.formulaCustom || "A");
  client.global.set("muParamsJson", JSON.stringify((ind.parametros || []).map(p => ({
    id: p.id,
    nombreParametro: p.nombreParametro || p.nombreVariable,
    nombreVariable: p.nombreVariable || p.nombreParametro,
    tipoDato: p.tipoDato || "Decimal"
  }))));
  // Free-text units (not Percentage|USD|Otro)
  client.global.set("muCustom", "NTU");
%}

### PUT /full — persist metaUnidad custom NTU
# @name putMetaUnidadCustom
PUT {{baseUrl}}/api/projects/{{proyectoId}}/full
Content-Type: application/json

{
  "actorUserId": {{evaluadorUserId}},
  "actorRole": "evaluador",
  "proyecto": {
    "nombreProyecto": "Proyecto QA planificación (editado)"
  },
  "odsIds": [{{muOdsId}}],
  "primaryOdsId": {{muOdsId}},
  "indicadores": [
    {
      "proyectoIndicadorId": {{muPiId}},
      "odsId": {{muOdsId}},
      "indicadorMasterId": {{muMasterId}},
      "metaValor": {{muMetaValor}},
      "metaUnidad": "{{muCustom}}",
      "metaNombre": "{{muMetaNombre}}",
      "formulaCustom": "{{muFormula}}",
      "parametros": {{muParamsJson}}
    }
  ]
}

> {%
  client.test("PUT meta_unidad custom 200", function() {
    client.assert(response.status === 200, "status 200 got " + response.status);
    client.assert(response.body.success === true, "success; errores=" + JSON.stringify(response.body.errores || []));
  });
%}

### GET editable — assert metaUnidad NTU persistió
# @name getEditableAfterMetaUnidad
GET {{baseUrl}}/api/projects/{{proyectoId}}/planificacion/editable?actorUserId={{evaluadorUserId}}&actorRole=evaluador

> {%
  client.test("metaUnidad NTU persistió (texto libre)", function() {
    client.assert(response.status === 200, "status 200");
    const piId = Number(client.global.get("muPiId"));
    const expected = client.global.get("muCustom");
    const ind = (response.body.indicadores || []).find(i => Number(i.proyectoIndicadorId) === piId);
    client.assert(!!ind, "indicador encontrado piId=" + piId);
    client.assert(ind.metaUnidad === expected, "metaUnidad=" + expected + " got " + ind.metaUnidad);
  });
%}

