### Objetivo 15: Vida de Ecosistemas Terrestres - HTTP Endpoints
### Base URL: http://localhost:8080

### Variables
@baseUrl = http://localhost:8080
@proyectoId = 15
@indicadorId = 15
@metaId = 15
@medicionId = 15

# ── Indicadores Específicos del ODS15 ──

### Obtener todos los indicadores del ODS15
GET {{baseUrl}}/api/ods/15/indicadores?proyectoId={{proyectoId}}

### Obtener indicador 15.1.1
GET {{baseUrl}}/api/ods/15/indicadores/15.1.1?proyectoId={{proyectoId}}

### Obtener indicador 15.1.2
GET {{baseUrl}}/api/ods/15/indicadores/15.1.2?proyectoId={{proyectoId}}

### Obtener indicador 15.2.1
GET {{baseUrl}}/api/ods/15/indicadores/15.2.1?proyectoId={{proyectoId}}

### Obtener indicador 15.3.1
GET {{baseUrl}}/api/ods/15/indicadores/15.3.1?proyectoId={{proyectoId}}

### Obtener indicador 15.4.1
GET {{baseUrl}}/api/ods/15/indicadores/15.4.1?proyectoId={{proyectoId}}

### Obtener indicador 15.4.2
GET {{baseUrl}}/api/ods/15/indicadores/15.4.2?proyectoId={{proyectoId}}

### Obtener indicador 15.5.1
GET {{baseUrl}}/api/ods/15/indicadores/15.5.1?proyectoId={{proyectoId}}

### Obtener indicador 15.6.1
GET {{baseUrl}}/api/ods/15/indicadores/15.6.1?proyectoId={{proyectoId}}

### Obtener indicador 15.7.1
GET {{baseUrl}}/api/ods/15/indicadores/15.7.1?proyectoId={{proyectoId}}

### Obtener indicador 15.8.1
GET {{baseUrl}}/api/ods/15/indicadores/15.8.1?proyectoId={{proyectoId}}

### Obtener indicador 15.9.1
GET {{baseUrl}}/api/ods/15/indicadores/15.9.1?proyectoId={{proyectoId}}

### Obtener indicador 15.a.1
GET {{baseUrl}}/api/ods/15/indicadores/15.a.1?proyectoId={{proyectoId}}

### Obtener indicador 15.b.1
GET {{baseUrl}}/api/ods/15/indicadores/15.b.1?proyectoId={{proyectoId}}

### Obtener indicador 15.c.1
GET {{baseUrl}}/api/ods/15/indicadores/15.c.1?proyectoId={{proyectoId}}

### Encontrar todos los indicadores por proyecto
GET {{baseUrl}}/api/ods/15/indicadores/proyecto?proyectoId={{proyectoId}}

### Encontrar indicadores por meta
GET {{baseUrl}}/api/ods/15/indicadores/meta?proyectoId={{proyectoId}}&metaPrefix=15.1

# ── Proyectos ──

### Obtener todos los proyectos del ODS15
GET {{baseUrl}}/api/ods/15/proyectos

### Obtener proyecto por ID
GET {{baseUrl}}/api/ods/15/proyectos/{{proyectoId}}

### Obtener todas las metas de proyecto
GET {{baseUrl}}/api/ods/15/proyectos/{{proyectoId}}/metas

### Obtener meta por ID
GET {{baseUrl}}/api/ods/15/metas/{{metaId}}

### Obtener todas las mediciones históricas
GET {{baseUrl}}/api/ods/15/indicadores/historicas/{{indicadorId}}

### Obtener medición histórica por ID
GET {{baseUrl}}/api/ods/15/mediciones/{{medicionId}}

### Calcular progreso del proyecto
GET {{baseUrl}}/api/ods/15/progreso/{{proyectoId}}

### Obtener estadísticas del ODS15
GET {{baseUrl}}/api/ods/15/estadisticas

### Verificar si proyecto existe
GET {{baseUrl}}/api/ods/15/proyectos/{{proyectoId}}/existe

### Verificar si indicador existe
GET {{baseUrl}}/api/ods/15/indicadores/{{indicadorId}}/existe

# ── CRUD Operaciones ──

### Crear nuevo proyecto
POST {{baseUrl}}/api/ods/15/proyecto
Content-Type: application/json

{
  "nombre": "Proyecto Vida Ecosistemas Test",
  "descripcion": "Proyecto de prueba para ODS15",
  "fechaInicio": "2024-01-01",
  "fechaFin": "2024-12-31",
  "presupuesto": 270000.0,
  "estado": "ACTIVO"
}

### Validar proyecto
POST {{baseUrl}}/api/ods/15/validar/proyecto
Content-Type: application/json

{
  "nombre": "Proyecto Validación Ecosistemas",
  "descripcion": "Proyecto para validar ODS15",
  "fechaInicio": "2024-01-01",
  "fechaFin": "2024-12-31",
  "presupuesto": 135000.0,
  "estado": "ACTIVO"
}

### Actualizar proyecto
PUT {{baseUrl}}/api/ods/15/proyecto/{{proyectoId}}
Content-Type: application/json

{
  "id": {{proyectoId}},
  "nombre": "Proyecto Ecosistemas Actualizado",
  "descripcion": "Proyecto actualizado para ODS15",
  "fechaInicio": "2024-01-01",
  "fechaFin": "2024-12-31",
  "presupuesto": 295000.0,
  "estado": "ACTIVO"
}

### Eliminar proyecto
DELETE {{baseUrl}}/api/ods/15/proyecto/{{proyectoId}}

### Crear nuevo indicador
POST {{baseUrl}}/api/ods/15/indicadores
Content-Type: application/json

{
  "codigo": "15.1.1",
  "nombre": "Indicador Ecosistemas Test",
  "descripcion": "Indicador de prueba para ODS15",
  "valorActual": 59.5,
  "valorMeta": 100.0,
  "unidadMedida": "porcentaje",
  "proyectoId": {{proyectoId}}
}

### Validar indicador
POST {{baseUrl}}/api/ods/15/validar/indicador
Content-Type: application/json

{
  "codigo": "15.2.1",
  "nombre": "Indicador Validación Ecosistemas",
  "descripcion": "Indicador para validar ODS15",
  "valorActual": 45.0,
  "valorMeta": 70.0,
  "unidadMedida": "porcentaje",
  "proyectoId": {{proyectoId}}
}

### Actualizar indicador
PUT {{baseUrl}}/api/ods/15/indicadores/{{indicadorId}}
Content-Type: application/json

{
  "id": {{indicadorId}},
  "codigo": "15.1.1",
  "nombre": "Indicador Ecosistemas Actualizado",
  "descripcion": "Indicador actualizado para ODS15",
  "valorActual": 63.0,
  "valorMeta": 100.0,
  "unidadMedida": "porcentaje",
  "proyectoId": {{proyectoId}}
}

### Eliminar indicador
DELETE {{baseUrl}}/api/ods/15/indicadores/{{indicadorId}}

### Crear nueva meta
POST {{baseUrl}}/api/ods/15/metas
Content-Type: application/json

{
  "codigo": "15.1",
  "descripcion": "Meta de prueba ODS15",
  "valorMeta": 100.0,
  "valorActual": 59.5,
  "proyectoId": {{proyectoId}}
}

### Actualizar meta
PUT {{baseUrl}}/api/ods/15/metas/{{metaId}}
Content-Type: application/json

{
  "id": {{metaId}},
  "codigo": "15.1",
  "descripcion": "Meta actualizada ODS15",
  "valorMeta": 100.0,
  "valorActual": 61.0,
  "proyectoId": {{proyectoId}}
}

### Eliminar meta
DELETE {{baseUrl}}/api/ods/15/metas/{{metaId}}

### Crear nueva medición histórica
POST {{baseUrl}}/api/ods/15/mediciones
Content-Type: application/json

{
  "indicadorId": {{indicadorId}},
  "fechaMedicion": "2024-01-15",
  "valor": 57.5,
  "observaciones": "Medición de prueba ODS15"
}

### Actualizar medición histórica
PUT {{baseUrl}}/api/ods/15/mediciones/{{medicionId}}
Content-Type: application/json

{
  "id": {{medicionId}},
  "indicadorId": {{indicadorId}},
  "fechaMedicion": "2024-01-15",
  "valor": 59.0,
  "observaciones": "Medición actualizada ODS15"
}

### Eliminar medición histórica
DELETE {{baseUrl}}/api/ods/15/mediciones/{{medicionId}}

# ── IOdsBaseController Methods ──

### Obtener todos los proyectos (base)
GET {{baseUrl}}/api/ods/15/all-proyectos

### Obtener proyecto por ID (base)
GET {{baseUrl}}/api/ods/15/proyecto/{{proyectoId}}

### Obtener todos los indicadores (base)
GET {{baseUrl}}/api/ods/15/base-indicadores?proyectoId={{proyectoId}}

### Obtener indicador por ID (base)
GET {{baseUrl}}/api/ods/15/indicadores/{{indicadorId}}

### Obtener metas de proyecto
GET {{baseUrl}}/api/ods/15/metas?proyectoId={{proyectoId}}

### Obtener meta por ID (base)
GET {{baseUrl}}/api/ods/15/metas/{{metaId}}

### Obtener mediciones históricas
GET {{baseUrl}}/api/ods/15/mediciones?indicadorId={{indicadorId}}

### Obtener medición histórica por ID (base)
GET {{baseUrl}}/api/ods/15/mediciones/{{medicionId}}

### Obtener estadísticas (base)
GET {{baseUrl}}/api/ods/15/base-estadisticas

### Obtener progreso del proyecto (base)
GET {{baseUrl}}/api/ods/15/base-progreso/{{proyectoId}}

### Verificar existencia de proyecto (base)
GET {{baseUrl}}/api/ods/15/proyecto/{{proyectoId}}/existe

### Verificar existencia de indicador (base)
GET {{baseUrl}}/api/ods/15/indicador/{{indicadorId}}/existe

### Verificar existencia de meta (base)
GET {{baseUrl}}/api/ods/15/meta/{{metaId}}/existe

### Verificar existencia de medición histórica (base)
GET {{baseUrl}}/api/ods/15/medicion/{{medicionId}}/existe