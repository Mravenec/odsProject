# ============================================================
# EJEMPLOS DE USO CON DATOS DE PRUEBA
# ============================================================

### Crear proyecto de prueba para ODS01
POST {{baseUrl}}/api/ods/01/proyecto
Content-Type: application/json

{
  "nombre": "Proyecto Reducción Pobreza 2024",
  "descripcion": "Proyecto piloto para reducir la pobreza en comunidades rurales",
  "fechaInicio": "2024-01-01",
  "fechaFin": "2024-12-31",
  "presupuesto": 250000.0,
  "estado": "ACTIVO",
  "usuarioId": 2
}

### Crear indicador de prueba para ODS01
POST {{baseUrl}}/api/ods/01/indicadores
Content-Type: application/json

{
  "codigo": "1.1.1",
  "nombre": "Proporción población bajo umbral pobreza",
  "descripcion": "Medición de población viviendo por debajo del umbral internacional de pobreza",
  "valorActual": 15.5,
  "valorMeta": 5.0,
  "unidadMedida": "porcentaje",
  "proyectoId": {{proyectoId}}
}

### Crear medición histórica de prueba
POST {{baseUrl}}/api/ods/01/mediciones
Content-Type: application/json

{
  "indicadorId": {{indicadorId}},
  "fechaMedicion": "2024-01-15",
  "valor": 16.2,
  "observaciones": "Medición trimestral de indicador de pobreza"
}

### Actualizar indicador
PUT {{baseUrl}}/api/ods/01/indicadores/{{indicadorId}}
Content-Type: application/json

{
  "id": {{indicadorId}},
  "codigo": "1.1.1",
  "nombre": "Proporción población bajo umbral pobreza Actualizado",
  "descripcion": "Medición actualizada de pobreza",
  "valorActual": 14.8,
  "valorMeta": 5.0,
  "unidadMedida": "porcentaje",
  "proyectoId": {{proyectoId}}
}

# ============================================================
# FIN DEL ARCHIVO DE MOCKS HTTP
# ============================================================
