### ============================================================
### MOCKS COMPLETOS DEL SISTEMA ODS - HTTP ENDPOINTS
### Compatible con Spring Boot REST Controllers
### Base URL: http://localhost:8080
### Todos los ODS (1-17) cubiertos
### ============================================================

### Variables Globales
@baseUrl = http://localhost:8080
@proyectoId = 1
@indicadorId = 1
@metaId = 1
@medicionId = 1

# ============================================================
# SISTEMA DE LOGIN - AUTENTICACIÓN Y GESTIÓN DE USUARIOS
# Compatible con LoginController.java
# ============================================================


### ============================================================
### SISTEMA DE LOGIN - AUTENTICACIÓN Y GESTIÓN DE USUARIOS
### Compatible con LoginController.java
### ============================================================

### Variables de Login
@token = gestor01_token_0
@email = ana.garcia@ods.cr
@usuarioId = 2

# ============================================================
# AUTENTICACIÓN
# ============================================================

### Login exitoso - gestor01 (ID: 2, Rol: Gestor)
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "ana.garcia@ods.cr",
  "password": "password123",
  "ip": "10.0.0.2",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Login exitoso - gestor02 (ID: 3, Rol: Consultor)
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "carlos.rodriguez@ods.cr",
  "password": "password123",
  "ip": "10.0.0.3",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Login exitoso - gestor03 (ID: 4, Rol: Auditor)
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "maria.jimenez@ods.cr",
  "password": "password123",
  "ip": "10.0.0.4",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Login exitoso - consultor01 (ID: 7, Rol: Consultor)
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "roberto.vega@ods.cr",
  "password": "password123",
  "ip": "10.0.0.7",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Login exitoso - auditor01 (ID: 8, Rol: Auditor)
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "sandra.perez@ods.cr",
  "password": "password123",
  "ip": "10.0.0.8",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Login fallido - contraseña incorrecta
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "ana.garcia@ods.cr",
  "password": "wrongpassword",
  "ip": "10.0.0.2",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Login fallido - email no existe
POST {{baseUrl}}/api/login/auth/login
Content-Type: application/json

{
  "email": "noexiste@ods.cr",
  "password": "password123",
  "ip": "10.0.0.2",
  "userAgent": "Mozilla/5.0 (Mock Browser)"
}

### Logout - cerrar sesión
POST {{baseUrl}}/api/login/auth/logout
Authorization: Bearer {{token}}

### Validar token - token válido
GET {{baseUrl}}/api/login/auth/validate
Authorization: Bearer {{token}}

### Validar token - token inválido
GET {{baseUrl}}/api/login/auth/validate
Authorization: Bearer invalid_token

### Refrescar token
POST {{baseUrl}}/api/login/auth/refresh
Authorization: Bearer {{token}}

# ============================================================
# GESTIÓN DE USUARIOS
# ============================================================

### Obtener usuario por ID (gestor01)
GET {{baseUrl}}/api/login/users/{{usuarioId}}

### Obtener usuario por username (gestor01)
GET {{baseUrl}}/api/login/users/username/gestor01

### Verificar si email existe
GET {{baseUrl}}/api/login/users/check-email/{{email}}

### Verificar si username existe
GET {{baseUrl}}/api/login/users/check-username/gestor01

### Iniciar recuperación de contraseña
POST {{baseUrl}}/api/login/users/recovery
Content-Type: application/json

{
  "email": "{{email}}"
}

### Validar formato de contraseña
POST {{baseUrl}}/api/login/users/validate-password
Content-Type: application/json

{
  "password": "Password123!"
}

# ============================================================
# GESTIÓN DE ROLES
# ============================================================

### Obtener todos los roles
GET {{baseUrl}}/api/login/roles

### Obtener rol por ID (Gestor)
GET {{baseUrl}}/api/login/roles/2

### Obtener rol por ID (Consultor)
GET {{baseUrl}}/api/login/roles/3

### Obtener rol por ID (Auditor)
GET {{baseUrl}}/api/login/roles/4

# ============================================================
# GESTIÓN DE SESIONES
# ============================================================

### Obtener sesiones activas del usuario
GET {{baseUrl}}/api/login/users/{{usuarioId}}/sessions

### Revocar todas las sesiones del usuario
POST {{baseUrl}}/api/login/users/{{usuarioId}}/revoke-all-sessions

# ============================================================
# PERMISOS ODS
# ============================================================

### Obtener permisos ODS del usuario (gestor01)
GET {{baseUrl}}/api/login/users/{{usuarioId}}/permits

### Verificar permiso para ODS específico (gestor01 - ODS1)
GET {{baseUrl}}/api/login/users/{{usuarioId}}/permits/1

### Verificar permiso para ODS específico (gestor01 - ODS2)
GET {{baseUrl}}/api/login/users/{{usuarioId}}/permits/2

### Verificar permiso para ODS específico (consultor01 - ODS1)
GET {{baseUrl}}/api/login/users/7/permits/1

# ============================================================
# AUDITORÍA Y SEGURIDAD
# ============================================================

### Obtener historial de login del usuario
GET {{baseUrl}}/api/login/users/{{usuarioId}}/login-history?dias=30

### Obtener intentos de login fallidos
GET {{baseUrl}}/api/login/auth/failed-attempts?horas=24

### Bloquear usuario
POST {{baseUrl}}/api/login/users/block
Content-Type: application/json

{
  "usuarioId": {{usuarioId}},
  "motivo": "Actividad sospechosa",
  "horas": 24
}

### Desbloquear usuario
POST {{baseUrl}}/api/login/users/{{usuarioId}}/unblock

# ============================================================
# ADMINISTRACIÓN
# ============================================================

### Obtener vista de auditoría reciente
GET {{baseUrl}}/api/login/admin/audit-recent?dias=7

### Obtener resumen general
GET {{baseUrl}}/api/login/admin/summary

### Obtener usuarios activos
GET {{baseUrl}}/api/login/admin/active-users

### Obtener detalle de indicadores
GET {{baseUrl}}/api/login/admin/indicators-detail

### Obtener estadísticas del sistema
GET {{baseUrl}}/api/login/admin/statistics

### Limpieza de datos expirados
POST {{baseUrl}}/api/login/admin/cleanup

# ============================================================
# UTILIDADES
# ============================================================

### Health check del sistema
GET {{baseUrl}}/api/login/health

# ============================================================
# ODS 01: FIN DE LA POBREZA
# ============================================================

### Obtener todos los indicadores del ODS01
GET {{baseUrl}}/api/ods/01/indicadores?proyectoId={{proyectoId}}

